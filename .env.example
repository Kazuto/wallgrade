# Running with Docker Compose: your wallpaper folder.
WALLPAPER_DIR=
# The image to run: latest (master), develop, or a version such as 1.2.0.
IMAGE_TAG=latest

# Running without Docker:
# Images to convert, scanned recursively; the output directory is skipped.
NUXT_SOURCE_DIR=./.data/source
# Where the <WxH>-<palette> folders are written (default: <source>/output).
NUXT_OUTPUT_DIR=
# Previews and generated LUTs.
NUXT_CACHE_DIR=./.data/cache

# Users, each signing in to a library of their own in a folder below this one.
# NUXT_USERS_DIR=./.data/users
# NUXT_ADMIN_USERNAME=admin
# NUXT_ADMIN_PASSWORD=
# At least 32 characters, e.g. from `openssl rand -base64 32`.
# NUXT_SESSION_PASSWORD=
# Only for plain HTTP other than localhost.
# NUXT_SESSION_COOKIE_SECURE=false

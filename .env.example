# Running with Docker Compose: your wallpaper folder.
WALLPAPER_DIR=

# Running without Docker:
# Images to convert, scanned recursively; the output directory is skipped.
NUXT_SOURCE_DIR=./.data/source
# Where the <WxH>-<palette> folders are written (default: <source>/output).
NUXT_OUTPUT_DIR=
# Previews and generated LUTs.
NUXT_CACHE_DIR=./.data/cache
